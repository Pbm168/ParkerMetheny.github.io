</div></footer>

<script>
(function(){
var tabs=[].slice.call(document.querySelectorAll('[role=tab]'));
function show(i){tabs.forEach(function(t,j){var on=i===j;t.setAttribute('aria-selected',on);t.tabIndex=on?0:-1;document.getElementById('p'+j).hidden=!on;});}
tabs.forEach(function(t,i){t.addEventListener('click',function(){show(i)});
t.addEventListener('keydown',function(e){var n=null;if(e.key==='ArrowDown'||e.key==='ArrowRight')n=(i+1)%tabs.length;if(e.key==='ArrowUp'||e.key==='ArrowLeft')n=(i+tabs.length-1)%tabs.length;if(n!==null){e.preventDefault();show(n);tabs[n].focus();}});});
var e=document.getElementById('e'),s=document.getElementById('s'),w=document.getElementById('w');
function f(n){return (n<0?'-':'')+'$'+Math.abs(Math.round(n)).toLocaleString('en-US');}
function calc(){document.getElementById('eo').textContent=f(+e.value);document.getElementById('so').textContent=f(+s.value);document.getElementById('wo').textContent=w.value;
document.getElementById('r').textContent=f(e.value-s.value*w.value);}
[e,s,w].forEach(function(x){x.addEventListener('input',calc)});calc();
})();
</script>
</body>
</html>
